<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="565.0" prefWidth="796.0" styleClass="login-bg" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
   <children>
      <AnchorPane maxHeight="400.0" maxWidth="400.0" styleClass="glass-pane">
         <children>
            <Label layoutX="162.0" layoutY="40.0" text="Log In" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            
            <VBox layoutX="50.0" layoutY="120.0" prefWidth="300.0" spacing="30.0">
               <children>
                  <TextField fx:id="emailField" promptText="Email" styleClass="glass-input" />
                  <PasswordField fx:id="passwordField" promptText="Password" styleClass="glass-input" />
               </children>
            </VBox>
            
            <Button layoutX="50.0" layoutY="260.0" onAction="#login" prefHeight="45.0" prefWidth="300.0" styleClass="gradient-button" text="Login" />
            
            <HBox alignment="CENTER" layoutX="50.0" layoutY="330.0" prefWidth="300.0" spacing="5.0">
               <children>
                  <Label text="Don't have an account?" textFill="WHITE" />
                  <Hyperlink onAction="#goToRegister" style="-fx-font-weight: bold;" text="Register" textFill="WHITE" />
               </children>
            </HBox>
         </children>
      </AnchorPane>
   </children>
</StackPane>
