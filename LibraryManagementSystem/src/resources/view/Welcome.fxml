<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane prefHeight="565.0" prefWidth="796.0" styleClass="welcome-bg" stylesheets="@../css/application.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.WelcomeController">
   <children>
      <AnchorPane maxHeight="400.0" maxWidth="500.0" styleClass="glass-pane">
         <children>
            <Label layoutX="32.0" layoutY="60.0" text="BOOKI Library System" textFill="#ff8c00">
               <font>
                  <Font name="System Bold" size="40.0" />
               </font>
            </Label>
            
            <Label layoutX="145.0" layoutY="120.0" text="Management Made Simple" textFill="WHITE" style="-fx-opacity: 0.8;">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>

            <VBox alignment="CENTER" layoutX="100.0" layoutY="180.0" prefWidth="300.0" spacing="20.0">
               <children>
                  <Button onAction="#login" prefHeight="45.0" prefWidth="250.0" styleClass="gradient-button" text="Login" />
                  
                  <Button onAction="#register" prefHeight="45.0" prefWidth="250.0" styleClass="gradient-button" text="Register" />
               </children>
            </VBox>
            
            
         </children>
      </AnchorPane>
   </children>
</StackPane>