<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<HBox prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UserDashboardController">
   <children>
      <VBox prefWidth="250.0" spacing="10" style="-fx-background-color: #E4CDBO; -fx-padding: 20; -fx-border-color: #D3D3D3; -fx-border-width: 0 1 0 0;">
         <children>
            <Label text="LIB-SYS" textFill="#5b4b41">
               <font><Font name="System Bold" size="24.0" /></font>
               <VBox.margin><Insets bottom="30.0" /></VBox.margin>
            </Label>
            
            <Label text="MAIN MENU" textFill="#7F8C8D">
               <font><Font name="System Bold" size="12.0" /></font>
               <VBox.margin><Insets bottom="5.0" /></VBox.margin>
            </Label>

            <Button onAction="#showMyBooks" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" text=" My Borrowed Books">
               <graphic><SVGPath content="M12,3L1,9L12,15L21,10.09V17H23V9M5,13.18V17.18L12,21L19,17.18V13.18L12,17L5,13.18Z" fill="#2c3e50" scaleX="0.8" scaleY="0.8" /></graphic>
            </Button>

            <Button onAction="#showBrowseLibrary" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" text=" Browse Library">
               <graphic><SVGPath content="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" fill="#2c3e50" scaleX="0.8" scaleY="0.8" /></graphic>
            </Button>

            <Button onAction="#showProfile" prefWidth="210.0" style="-fx-background-color: white; -fx-text-fill: #2c3e50; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #BDC3C7; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" text=" My Profile">
               <graphic><SVGPath content="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" fill="#2c3e50" scaleX="0.8" scaleY="0.8" /></graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />
            
            <Button onAction="#handleLogout" prefWidth="210.0" style="-fx-background-color: #F2D9CE; -fx-text-fill: #C0392B; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-border-color: #260f06 -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 10;" text=" Logout">
               <graphic><SVGPath content="M16,17V14H9V10H16V7L21,12L16,17M14,2A2,2 0 0,1 16,4V9H14V4H5V20H14V15H16V20A2,2 0 0,1 14,22H5A2,2 0 0,1 3,20V4A2,2 0 0,1 5,2H14Z" fill="#C0392B" scaleX="0.8" scaleY="0.8" /></graphic>
            </Button>
         </children>
      </VBox>

      <VBox style="-fx-background-color: #FFF5E1;" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #260f06; -fx-padding: 15 30 15 30;">
               <children>
                  <VBox>
                     <Label fx:id="sectionHeader" text="My Profile" textFill="WHITE">
                        <font><Font name="System Bold" size="24.0" /></font>
                     </Label>
                     <Label fx:id="welcomeLabel" text="Welcome back, User!" textFill="#FFDAB9" />
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="searchField" prefWidth="300.0" promptText="Search library..." style="-fx-background-radius: 20; -fx-padding: 8; -fx-background-color: white; -fx-border-color: #BDC3C7; -fx-border-radius: 20;" visible="false" />
               </children>
            </HBox>
            
            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS">
               <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
               </StackPane>
         </children>
      </VBox>
   </children>
</HBox>
