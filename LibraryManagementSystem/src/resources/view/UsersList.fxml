<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="15.0" style="-fx-padding: 25; -fx-background-color: #FFEAD1;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UsersListController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="20">
		    <children>
		        <Label text="User Management" textFill="#6f42c1" style="-fx-font-size: 24; -fx-font-weight: bold;" />
		        <Region HBox.hgrow="ALWAYS" />
		        
		        <TextField fx:id="searchField" prefWidth="250.0" promptText="🔍 Search users..." 
		                   style="-fx-background-radius: 20; -fx-background-color: rgba(255,255,255,0.8); -fx-border-color: #ddd; -fx-border-radius: 20;" />
		        
		        <Button onAction="#showAddPanel" text="+ Add Member" 
		                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;" />
		    </children>
		</HBox>

        <SplitPane dividerPositions="0.6" orientation="VERTICAL" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <items>
                <TableView fx:id="usersTable">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="colName" prefWidth="180.0" text="NAME" />
                        <TableColumn fx:id="colEmail" prefWidth="200.0" text="EMAIL" />
                        <TableColumn fx:id="colRole" prefWidth="100.0" text="ROLE" />
                        <TableColumn fx:id="colAction" prefWidth="150.0" text="ACTIONS" />
                    </columns>
                </TableView>

                <VBox fx:id="editPane" spacing="15.0" style="-fx-padding: 20; -fx-background-color: #f8f9fa; -fx-background-radius: 10; -fx-border-color: #dee2e6;">
                    <Label text="Edit User Information" style="-fx-font-weight: bold; -fx-font-size: 16;" textFill="#6f42c1" />
                    <GridPane hgap="15" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="100"/>
                            <ColumnConstraints prefWidth="250"/>
                            <ColumnConstraints prefWidth="100"/>
                            <ColumnConstraints prefWidth="250"/>
                        </columnConstraints>
                        <children>
                            <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="editNameField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            
                            <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <TextField fx:id="editEmailField" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                            
                            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="editPhoneField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            
                            <Label text="Role:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <ComboBox fx:id="roleComboBox" GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>
                        </children>
                    </GridPane>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Cancel" onAction="#cancelEdit" style="-fx-background-color: #adb5bd; -fx-text-fill: white;"/>
                        <Button text="Update User" onAction="#handleSave" style="-fx-background-color: #6f42c1; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </items>
        </SplitPane>
    </children>
</VBox>